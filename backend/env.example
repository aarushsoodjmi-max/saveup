# Copy this file to .env and fill in real values for your environment.
# Every value shown here is either a working local-dev default or an
# obvious placeholder that MUST be changed before deploying anywhere
# that isn't your own machine.

# --- App ---
APP_NAME="SaveUp API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (MySQL via PyMySQL) ---
DATABASE_URL=mysql+pymysql://root:sample_password@localhost:3306/saveup
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_super_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HASH_SECRET=CHANGE_ME_OTP_PEPPER
# Echoes the generated OTP back in API responses so you can exercise
# the full auth/withdrawal flow without a real SMS provider. Set to
# false (or just deploy with ENVIRONMENT=production) before going live.
OTP_DEBUG_EXPOSE=true

# --- Rate limiting ---
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_HOUR=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- Idempotency ---
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# --- Ledger retry (transient MySQL write-conflict recovery, e.g. error
# 1020/1213/1205 during a row-locked deposit/withdrawal/refund) ---
LEDGER_RETRY_MAX_ATTEMPTS=3
LEDGER_RETRY_BASE_BACKOFF_SECONDS=0.05

# --- Mock payment provider ---
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_WEBHOOK_SECRET

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Logging ---
LOG_LEVEL=INFO
